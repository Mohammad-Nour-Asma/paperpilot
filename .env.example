# Default: Ollama on your Mac (free, no account).
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3:8b

# Option: OpenRouter (one key, many hosted models). Uncomment to use.
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-...
# LLM_MODEL=<model id from openrouter.ai/models>
